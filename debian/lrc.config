# licensecheck detects only Artistic; debian/copyright records both licenses.
xymond/webfiles/maint_header

# The introductory comment mentions GPL, but explicitly states that
# this code is NOT licensed under the GPL. The actual license is SSLeay.
lib/ripemd.h
lib/rmd160c.c
lib/rmdconst.h
lib/rmd_locl.h

# The introductory comment says GPL, while the original permission
# notice grants use under the Zlib terms recorded in debian/copyright.
lib/md5.c

# Contains GPL-2 code and incorporated NTP-licensed code.
# Both notices apply to their respective portions; this is not
# an alternative-license choice as "and/or" might suggest.
xymonnet/dns2.c

# These files describe the project license, but licensecheck
# detects only an unversioned GPL.
common/xymon.7
docs/manpages/man7/xymon.7.html
rpm/xymon.spec
debian/lrc.config
