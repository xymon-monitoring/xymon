# Xymon main Makefile
#
# This file is included from the Makefile created by the "configure" script



#####################
# Build targets
#####################

CFLAGS += -I$(BUILDTOPDIR)/include

ifeq ($(CLIENTONLY),yes)
	BUILDTARGETS = client
	CFLAGS += -DCLIENTONLY=1
	XYMONCLIENTHOME = $(XYMONTOPDIR)
	XYMONHOME = $(XYMONTOPDIR)
ifeq ($(LOCALCLIENT),yes)
	CLIENTTARGETS = lib-client common-client build-build xymond-client
	INSTALLTARGETS = install-client install-localclient install-clientmsg
	CFLAGS += -DLOCALCLIENT=1 $(PCREINCDIR)
else
	CLIENTTARGETS = lib-client common-client build-build
	INSTALLTARGETS = install-client install-clientmsg
endif
else
	BUILDTARGETS = lib-build common-build xymongen-build xymonnet-build xymonproxy-build docs-build build-build xymond-build web-build client
	CLIENTTARGETS = lib-client common-client build-build
	INSTALLTARGETS = install-xymongen install-xymonnet install-xymonproxy install-xymond install-web install-docs install-client install-servermsg
	CFLAGS += $(PCREINCDIR)
	XYMONCLIENTHOME = $(XYMONTOPDIR)/client
	XYMONHOME = $(XYMONTOPDIR)/server
endif

# A Makefile written before the runtime directory existed does not define it,
# and the placeholders in xymonserver.cfg and xymon.sh would then be
# substituted with nothing. loadenv() repairs an empty XYMONRUNDIR in
# xymonserver.cfg, but xymon.sh has the value built in: its pidfile would be
# "/xymonlaunch.pid", which as root is created rather than refused.
#
# ?= is not enough: it assigns only when a variable is undefined, so it
# rescues a Makefile with no line at all but not one that defines it empty.
ifeq ($(strip $(XYMONRUNDIR)),)
XYMONRUNDIR := $(XYMONLOGDIR)
endif
# Exported rather than appended to each sub-make's argument list: those
# lines are long and shared, so every change needing a new variable
# would collide with every other one.
export XYMONRUNDIR

# Where the client's own files go. A client-only build honours the
# INSTALLETCDIR, INSTALLBINDIR and INSTALLTMPDIR configure.client already
# records and nothing read; a server build keeps its embedded client under
# XYMONCLIENTHOME. "override", because an empty value on the command line
# would otherwise win over the default and install into INSTALLROOT itself.
#
# CLIENTHOME is XYMONCLIENTHOME without a trailing slash: the defaults are
# built from it, and install-clientdirs recognises them by name, so /xc/ and
# /xc are the same home.
CLIENTHOME = $(patsubst %/,%,$(XYMONCLIENTHOME))
ifeq ($(CLIENTONLY),yes)
ifeq ($(strip $(INSTALLCLIENTETCDIR)),)
override INSTALLCLIENTETCDIR = $(INSTALLETCDIR)
endif
ifeq ($(strip $(INSTALLCLIENTBINDIR)),)
override INSTALLCLIENTBINDIR = $(INSTALLBINDIR)
endif
ifeq ($(strip $(INSTALLCLIENTTMPDIR)),)
override INSTALLCLIENTTMPDIR = $(INSTALLTMPDIR)
endif
endif
ifeq ($(strip $(INSTALLCLIENTETCDIR)),)
override INSTALLCLIENTETCDIR = $(CLIENTHOME)/etc
endif
ifeq ($(strip $(INSTALLCLIENTBINDIR)),)
override INSTALLCLIENTBINDIR = $(CLIENTHOME)/bin
endif
ifeq ($(strip $(INSTALLCLIENTTMPDIR)),)
override INSTALLCLIENTTMPDIR = $(CLIENTHOME)/tmp
endif
ifeq ($(strip $(INSTALLCLIENTLOGDIR)),)
override INSTALLCLIENTLOGDIR = $(CLIENTHOME)/logs
endif

ifndef INSTALLBINDIR
INSTALLBINDIR = $(XYMONHOME)/bin
endif
# The development kit -- headers, static libraries and xymon.pc -- installs as
# one relocatable subtree. A source install puts the whole kit under
# $(XYMONHOME)/sdk; a packager overrides INSTALLINCDIR and INSTALLLIBDIR to
# split them across FHS trees (/usr/include vs /usr/lib), leaving INSTALLSDKDIR
# unused.
ifndef INSTALLSDKDIR
INSTALLSDKDIR = $(XYMONHOME)/sdk
endif
# The include root holds include/ and lib/ side by side: libxymon.h reaches its
# remaining headers through "../lib/..." includes, so the pair has to move
# together. It is the sdk dir itself, not an include/ beneath it, or the
# default -I$(INSTALLINCDIR)/include would double to .../include/include.
ifndef INSTALLINCDIR
INSTALLINCDIR = $(INSTALLSDKDIR)
endif
# The archives sit beside the lib/ headers they belong to -- the source lib/
# carries both *.h and *.a -- so the whole kit is a single tree.
ifndef INSTALLLIBDIR
INSTALLLIBDIR = $(INSTALLSDKDIR)/lib
endif
# xymon.pc goes with the archives by default; a packager points it at the
# directory pkg-config searches, such as $(libdir)/pkgconfig.
ifndef INSTALLPCDIR
INSTALLPCDIR = $(INSTALLLIBDIR)/pkgconfig
endif
# The version string, read once from the header for xymon.pc.
XYMONVERSION := $(shell sed -n 's/.*VERSION "\([^"]*\)".*/\1/p' include/version.h)
ifndef INSTALLETCDIR
INSTALLETCDIR = $(XYMONHOME)/etc
endif
ifndef INSTALLEXTDIR
INSTALLEXTDIR = $(XYMONHOME)/ext
endif
# Where systemd unit files go, e.g. /usr/lib/systemd/system. Unset,
# nothing is installed and the .DIST is only a sample -- which is what a
# source install on a host without systemd wants.
#
# Appended rather than written into the three INSTALLTARGETS assignments:
# those are the lines every change to the install touches, so each new
# variable would collide with every other one. The target is a no-op
# unless the variable is set, so carrying it everywhere costs nothing.
INSTALLTARGETS += install-systemd
ifndef INSTALLTMPDIR
INSTALLTMPDIR = $(XYMONHOME)/tmp
endif
ifndef INSTALLWEBDIR
INSTALLWEBDIR = $(XYMONHOME)/web
endif
ifndef INSTALLWWWDIR
INSTALLWWWDIR = $(XYMONHOME)/www
endif
# The www tree mixes shipped content -- gifs, help, menu -- with state
# the daemons write. INSTALLSTATICWWWDIR puts the shipped part somewhere
# of its own, /usr/share on an FHS layout, and symlinks it back so every
# /xymon/ URL and on-disk path still resolves. Unset it is INSTALLWWWDIR
# and nothing changes.
ifndef INSTALLSTATICWWWDIR
INSTALLSTATICWWWDIR = $(INSTALLWWWDIR)
endif
# Exported rather than appended to each sub-make's argument list: those
# lines are long and shared, so every change needing a new variable
# would collide with every other one.
export INSTALLSTATICWWWDIR

MINARESVER = 1.5.1
FPINGVER = 3.0

IDTOOL := $(shell if test `uname -s` = "SunOS"; then echo /usr/xpg4/bin/id; else echo id; fi)

ifdef RPATH
RPATHOPT := $(RPATH)$(shell echo $(RPATHVAL) | sed -e 's/ / $(RPATH)/g')
endif

all: include/config.h $(BUILDTARGETS)
	@echo ""
	@echo "Build complete."
	@echo ""
	@echo ""
	@echo "Now run '${MAKE} install' as root"
	@echo ""

client: include/config.h $(CLIENTTARGETS)
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" XYMONHOME="$(XYMONCLIENTHOME)" XYMONHOSTIP="$(XYMONHOSTIP)" XYMONCLIENTRUNDIR="$(XYMONCLIENTRUNDIR)" LOCALCLIENT="$(LOCALCLIENT)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)" LIBRTDEF="$(LIBRTDEF)" $(MAKE) -C client all

include/config.h:
	MAKE="$(MAKE)" CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" $(BUILDTOPDIR)/build/genconfig.sh

ifeq ($(CLIENTONLY),yes)
build-build: include/config.h lib-client
else
build-build: include/config.h lib-build
endif
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)" LIBRTDEF="$(LIBRTDEF)" XYMONHOME="$(XYMONHOME)" $(MAKE) -C build all

lib-build: include/config.h
	sh $(BUILDTOPDIR)/build/build-id.sh
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" OSDEF="$(OSDEF)" RPATHOPT="$(RPATHOPT)" PCREINCDIR="$(PCREINCDIR)" ZLIBINCDIR="$(ZLIBINCDIR)" SSLFLAGS="$(SSLFLAGS)" SSLINCDIR="$(SSLINCDIR)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)" LIBRTDEF="$(LIBRTDEF)" XYMONTOPDIR="$(XYMONTOPDIR)" XYMONHOME="$(XYMONHOME)" XYMONCLIENTHOME=$(XYMONCLIENTHOME) XYMONLOGDIR="$(XYMONLOGDIR)" XYMONHOSTNAME="$(XYMONHOSTNAME)" XYMONHOSTIP="$(XYMONHOSTIP)" XYMONHOSTOS="$(XYMONHOSTOS)" $(MAKE) -C lib all

ifeq ($(CLIENTONLY),yes)
lib-client: include/config.h
else
lib-client: include/config.h lib-build
endif
	sh $(BUILDTOPDIR)/build/build-id.sh
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" OSDEF="$(OSDEF)" RPATHOPT="$(RPATHOPT)" PCREINCDIR="$(PCREINCDIR)" ZLIBINCDIR="$(ZLIBINCDIR)" SSLFLAGS="$(SSLFLAGS)" SSLINCDIR="$(SSLINCDIR)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)" LIBRTDEF="$(LIBRTDEF)" XYMONTOPDIR="$(XYMONTOPDIR)" XYMONHOME="$(XYMONCLIENTHOME)" XYMONCLIENTHOME=$(XYMONCLIENTHOME) XYMONLOGDIR="$(XYMONLOGDIR)" XYMONHOSTNAME="$(XYMONHOSTNAME)" XYMONHOSTIP="$(XYMONHOSTIP)" XYMONHOSTOS="$(XYMONHOSTOS)" LOCALCLIENT="$(LOCALCLIENT)" $(MAKE) -C lib client

common-build: lib-build
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" SSLFLAGS="$(SSLFLAGS)" SSLINCDIR="$(SSLINCDIR)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)"  ZLIBLIBS="$(ZLIBLIBS)" LIBRTDEF="$(LIBRTDEF)" XYMONHOME="$(XYMONHOME)" $(MAKE) -C common all

ifeq ($(CLIENTONLY),yes)
common-client: lib-client
else
common-client: lib-client common-build
endif
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" SSLFLAGS="$(SSLFLAGS)" SSLINCDIR="$(SSLINCDIR)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)"  ZLIBLIBS="$(ZLIBLIBS)" LIBRTDEF="$(LIBRTDEF)" XYMONHOME="$(XYMONCLIENTHOME)" $(MAKE) -C common client

xymongen-build: lib-build common-build
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" SSLFLAGS="$(SSLFLAGS)" SSLINCDIR="$(SSLINCDIR)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)" LIBRTDEF="$(LIBRTDEF)" XYMONHOME="$(XYMONHOME)" XYMONVAR="$(XYMONVAR)" HISTGRAPHDEF="$(HISTGRAPHDEF)" RUNTIMEDEFS="$(RUNTIMEDEFS)" PCREINCDIR="$(PCREINCDIR)" PCRELIBS="$(PCRELIBS)" ZLIBINCDIR="$(ZLIBINCDIR)" ZLIBLIBS="$(ZLIBLIBS)" $(MAKE) -C xymongen all


xymonnet-build: lib-build common-build
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" SSLFLAGS="$(SSLFLAGS)" SSLINCDIR="$(SSLINCDIR)" SSLLIBS="$(SSLLIBS)" DOLDAP="$(DOLDAP)" LDAPFLAGS="$(LDAPFLAGS)" LDAPINCDIR="$(LDAPINCDIR)" LDAPLIBS="$(LDAPLIBS)" DOSNMP="$(DOSNMP)" SNMPINCDIR="$(SNMPINCDIR)" SNMPLIBS="$(SNMPLIBS)" NETLIBS="$(NETLIBS)" XYMONHOME="$(XYMONHOME)" FPINGVER="$(FPINGVER)" RUNTIMEDEFS="$(RUNTIMEDEFS)" PCREINCDIR="$(PCREINCDIR)" PCRELIBS="$(PCRELIBS)" CARESINCDIR="$(CARESINCDIR)" CARESLIBS="$(CARESLIBS)" SQLITELIBS="$(SQLITELIBS)" ZLIBINCDIR="$(ZLIBINCDIR)" ZLIBLIBS="$(ZLIBLIBS)" LIBRTDEF="$(LIBRTDEF)" $(MAKE) -C xymonnet all

xymonproxy-build: lib-build common-build
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)" LIBRTDEF="$(LIBRTDEF)" XYMONHOME="$(XYMONHOME)" $(MAKE) -C xymonproxy all

xymond-build: lib-build build-build common-build 
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" DORRD="$(DORRD)" RRDDEF="$(RRDDEF)" RRDINCDIR="$(RRDINCDIR)" PCREINCDIR="$(PCREINCDIR)" SSLFLAGS="$(SSLFLAGS)" SSLINCDIR="$(SSLINCDIR)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)" RRDLIBS="$(RRDLIBS)" PCRELIBS="$(PCRELIBS)" SQLITELIBS="$(SQLITELIBS)" ZLIBINCDIR="$(ZLIBINCDIR)" ZLIBLIBS="$(ZLIBLIBS)" LIBRTDEF="$(LIBRTDEF)" XYMONTOPDIR="$(XYMONTOPDIR)" XYMONHOME="$(XYMONHOME)" XYMONVAR="$(XYMONVAR)" XYMONLOGDIR="$(XYMONLOGDIR)" XYMONHOSTNAME="$(XYMONHOSTNAME)" XYMONHOSTIP="$(XYMONHOSTIP)" XYMONHOSTOS="$(XYMONHOSTOS)" XYMONUSER="$(XYMONUSER)" CGIDIR="$(CGIDIR)" SECURECGIDIR="$(SECURECGIDIR)" XYMONHOSTURL="$(XYMONHOSTURL)" XYMONCGIURL="$(XYMONCGIURL)" SECUREXYMONCGIURL="$(SECUREXYMONCGIURL)" MAILPROGRAM="$(MAILPROGRAM)" RUNTIMEDEFS="$(RUNTIMEDEFS)" INSTALLWWWDIR="$(INSTALLWWWDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" FPING="$(FPING)" $(MAKE) -C xymond all

web-build: lib-build build-build common-build 
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" DORRD="$(DORRD)" RRDDEF="$(RRDDEF)" RRDINCDIR="$(RRDINCDIR)" PCREINCDIR="$(PCREINCDIR)" ZLIBINCDIR="$(ZLIBINCDIR)" ZLIBLIBS="$(ZLIBLIBS)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)" RRDLIBS="$(RRDLIBS)" PCRELIBS="$(PCRELIBS)" LIBRTDEF="$(LIBRTDEF)" XYMONTOPDIR="$(XYMONTOPDIR)" XYMONHOME="$(XYMONHOME)" XYMONVAR="$(XYMONVAR)" XYMONLOGDIR="$(XYMONLOGDIR)" XYMONHOSTNAME="$(XYMONHOSTNAME)" XYMONHOSTIP="$(XYMONHOSTIP)" XYMONHOSTOS="$(XYMONHOSTOS)" XYMONUSER="$(XYMONUSER)" CGIDIR="$(CGIDIR)" SECURECGIDIR="$(SECURECGIDIR)" XYMONHOSTURL="$(XYMONHOSTURL)" XYMONCGIURL="$(XYMONCGIURL)" SECUREXYMONCGIURL="$(SECUREXYMONCGIURL)" MAILPROGRAM="$(MAILPROGRAM)" RUNTIMEDEFS="$(RUNTIMEDEFS)" INSTALLWWWDIR="$(INSTALLWWWDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" $(MAKE) -C web all

xymond-client: lib-client build-build common-client
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" LIBRTDEF="$(LIBRTDEF)" RRDDEF="$(RRDDEF)" RRDINCDIR="$(RRDINCDIR)" PCREINCDIR="$(PCREINCDIR)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)" RRDLIBS="$(RRDLIBS)" PCRELIBS="$(PCRELIBS)" ZLIBINCDIR="$(ZLIBINCDIR)" ZLIBLIBS="$(ZLIBLIBS)" XYMONTOPDIR="$(XYMONTOPDIR)" XYMONHOME="$(XYMONHOME)" XYMONVAR="$(XYMONVAR)" XYMONLOGDIR="$(XYMONLOGDIR)" XYMONHOSTNAME="$(XYMONHOSTNAME)" XYMONHOSTIP="$(XYMONHOSTIP)" XYMONHOSTOS="$(XYMONHOSTOS)" XYMONUSER="$(XYMONUSER)" CGIDIR="$(CGIDIR)" SECURECGIDIR="$(SECURECGIDIR)" XYMONHOSTURL="$(XYMONHOSTURL)" XYMONCGIURL="$(XYMONCGIURL)" SECUREXYMONCGIURL="$(SECUREXYMONCGIURL)" MAILPROGRAM="$(MAILPROGRAM)" RUNTIMEDEFS="$(RUNTIMEDEFS)" INSTALLWWWDIR="$(INSTALLWWWDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" $(MAKE) -C xymond client

docs-build:
	XYMONHOSTURL="$(XYMONHOSTURL)" XYMONCGIURL="$(XYMONCGIURL)" SECUREXYMONCGIURL="$(SECUREXYMONCGIURL)" INSTALLWWWDIR="$(INSTALLWWWDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" CGIDIR="$(CGIDIR)" SECURECGIDIR="$(SECURECGIDIR)" $(MAKE) -C docs all

custom-build: lib-build
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" RRDDEF="$(RRDDEF)" RRDINCDIR="$(RRDINCDIR)" PCREINCDIR="$(PCREINCDIR)" NETLIBS="$(NETLIBS)" RRDLIBS="$(RRDLIBS)" PCRELIBS="$(PCRELIBS)" ZLIBINCDIR="$(ZLIBINCDIR)" ZLIBLIBS="$(ZLIBLIBS)" XYMONTOPDIR="$(XYMONTOPDIR)" XYMONHOME="$(XYMONHOME)" XYMONVAR="$(XYMONVAR)" XYMONLOGDIR="$(XYMONLOGDIR)" XYMONHOSTNAME="$(XYMONHOSTNAME)" XYMONHOSTIP="$(XYMONHOSTIP)" XYMONHOSTOS="$(XYMONHOSTOS)" XYMONUSER="$(XYMONUSER)" CGIDIR="$(CGIDIR)" SECURECGIDIR="$(SECURECGIDIR)" XYMONHOSTURL="$(XYMONHOSTURL)" XYMONCGIURL="$(XYMONCGIURL)" SECUREXYMONCGIURL="$(SECUREXYMONCGIURL)" MAILPROGRAM="$(MAILPROGRAM)" RUNTIMEDEFS="$(RUNTIMEDEFS)" INSTALLWWWDIR="$(INSTALLWWWDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" $(MAKE) -C custom all || echo "Skipped custom modules"

demo-build:
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" NETLIBS="$(NETLIBS)" $(MAKE) -C demotool all


win32: include/config.h
	CC="$(CC)" CFLAGS="$(CFLAGS) -DXYMONWINCLIENT -DCLIENTONLY" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" SSLFLAGS="$(SSLFLAGS)" SSLINCDIR="$(SSLINCDIR)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)" LIBRTDEF="$(LIBRTDEF)" XYMONHOME="$(XYMONHOME)" XYMONTOPDIR="$(XYMONTOPDIR)" XYMONLOGDIR="$(XYMONLOGDIR)" XYMONHOSTNAME="$(XYMONHOSTNAME)" XYMONHOSTIP="$(XYMONHOSTIP)" XYMONHOSTOS="$(XYMONHOSTOS)" $(MAKE) -C common xymon.exe

#####################
# Regression testsuite
#####################
# Runs every executable test under tests/ via the shared runner. The runner
# resolves the repo root itself, so it works from any cwd. See tests/README.md.
.PHONY: test
test:
	$(BUILDTOPDIR)/tests/testsuite

# Cleanup targets
#####################
distclean: allclean
	rm -f Makefile
	rm -rf debbuild rpmbuild

allclean: clean

clean:
	$(MAKE) -C build clean
	$(MAKE) -C lib clean
	$(MAKE) -C common clean
	$(MAKE) -C xymongen clean
	$(MAKE) DOSNMP="$(DOSNMP)" DOLDAP="$(DOLDAP)" -C xymonnet clean
	$(MAKE) -C xymonproxy clean
	$(MAKE) DORRD="$(DORRD)" -C xymond clean
	$(MAKE) DORRD="$(DORRD)" -C web clean
	$(MAKE) -C docs clean
	$(MAKE) -C client clean
#	$(MAKE) -C demotool clean
#	$(MAKE) -C custom clean || echo ""
	rm -f ./*~ include/config.h build/build-id include/*~ debian/*~ rpm/*~ contrib/*~


####################
# Install targets
####################

install: $(INSTALLTARGETS)

# Where this system keeps service environment files. The unit reads
# $(INSTALLENVDIR)/xymonlaunch for XYMONLAUNCHOPTS; a distribution sets
# this to its own convention, and the default keeps a source install
# reading a path that actually exists.
ifndef INSTALLENVDIR
INSTALLENVDIR = $(XYMONHOME)/etc
endif
export INSTALLENVDIR

# Generated from the .DIST with this build's paths, so the unit works
# wherever the tree was installed.
install-systemd:
ifneq ($(strip $(INSTALLSYSTEMDDIR)),)
	mkdir -p $(INSTALLROOT)$(INSTALLSYSTEMDDIR)
	XYMONHOME='$(XYMONHOME)' XYMONUSER='$(XYMONUSER)' INSTALLENVDIR='$(INSTALLENVDIR)' build/subst.sh XYMONHOME XYMONUSER INSTALLENVDIR <tools/xymonlaunch.service.DIST >$(INSTALLROOT)$(INSTALLSYSTEMDDIR)/xymonlaunch.service
	chmod 644 $(INSTALLROOT)$(INSTALLSYSTEMDDIR)/xymonlaunch.service
endif

install-servermsg:
	@echo ""
	@echo "Installation complete."
	@echo ""
	@echo "You must configure your webserver for the Xymon webpages and CGI-scripts."
	@echo "A sample Apache configuration is in ${XYMONHOME}/etc/xymon-apache.conf"
	@echo "If you have your Administration CGI scripts in a separate directory,"
	@echo "then you must also setup the password-file with the htpasswd command."
	@echo ""
	@echo "To start Xymon, as the $(XYMONUSER) user run '${XYMONHOME}/bin/xymon.sh start'"
	@echo "To view the Xymon webpages, go to http://${XYMONHOSTNAME}${XYMONHOSTURL}"

# Each directory, and every parent mkdir -p makes for it, is created 755
# whatever the umask, or a package built under umask 077 ships directories
# the xymon user cannot enter: the chmod 755 below is skipped under PKGBUILD
# and never reaches the parents. A directory that already exists is left as
# it is.
install-dirs:
	(umask 022 && mkdir -p $(INSTALLROOT)$(XYMONHOME) $(INSTALLROOT)$(XYMONHOME)/download $(INSTALLROOT)$(XYMONVAR))
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(XYMONHOME) $(INSTALLROOT)$(XYMONHOME)/download $(INSTALLROOT)$(XYMONVAR)
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(XYMONHOME) $(INSTALLROOT)$(XYMONHOME)/download $(INSTALLROOT)$(XYMONVAR)
	# These install directories end up owned by $(XYMONUSER), who may relocate one
	# with a symlink (mkdir -p no-ops and chown -h acts on the link, on purpose).
	# chmod has no portable -h, so skip it when the name is a symlink rather than
	# follow it to the target's mode -- as for the $(XYMONVAR) data dirs below.
	for d in $(INSTALLROOT)$(XYMONHOME) $(INSTALLROOT)$(XYMONHOME)/download $(INSTALLROOT)$(XYMONVAR); do test -L $$d || chmod 755 $$d; done
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(INSTALLBINDIR))
ifneq ($(INSTALLBINDIR),$(XYMONHOME)/bin)
	rm -f $(INSTALLROOT)$(XYMONHOME)/bin || true
	ln -s $(INSTALLBINDIR) $(INSTALLROOT)$(XYMONHOME)/bin || true
endif
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(INSTALLBINDIR)
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(INSTALLBINDIR)
	test -L $(INSTALLROOT)$(INSTALLBINDIR) || chmod 755 $(INSTALLROOT)$(INSTALLBINDIR)
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(INSTALLETCDIR))
ifneq ($(INSTALLETCDIR),$(XYMONHOME)/etc)
	rm -f $(INSTALLROOT)$(XYMONHOME)/etc || true
	ln -s $(INSTALLETCDIR) $(INSTALLROOT)$(XYMONHOME)/etc || true
endif
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(INSTALLETCDIR)
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(INSTALLETCDIR)
	test -L $(INSTALLROOT)$(INSTALLETCDIR) || chmod 755 $(INSTALLROOT)$(INSTALLETCDIR)
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(INSTALLEXTDIR))
ifneq ($(INSTALLEXTDIR),$(XYMONHOME)/ext)
	rm -f $(INSTALLROOT)$(XYMONHOME)/ext || true
	ln -s $(INSTALLEXTDIR) $(INSTALLROOT)$(XYMONHOME)/ext || true
endif
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(INSTALLEXTDIR)
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(INSTALLEXTDIR)
	test -L $(INSTALLROOT)$(INSTALLEXTDIR) || chmod 755 $(INSTALLROOT)$(INSTALLEXTDIR)
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(INSTALLTMPDIR))
ifneq ($(INSTALLTMPDIR),$(XYMONHOME)/tmp)
	rm -f $(INSTALLROOT)$(XYMONHOME)/tmp || true
	ln -s $(INSTALLTMPDIR) $(INSTALLROOT)$(XYMONHOME)/tmp || true
endif
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(INSTALLTMPDIR)
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(INSTALLTMPDIR)
	test -L $(INSTALLROOT)$(INSTALLTMPDIR) || chmod 755 $(INSTALLROOT)$(INSTALLTMPDIR)
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(INSTALLWEBDIR))
ifneq ($(INSTALLWEBDIR),$(XYMONHOME)/web)
	rm -f $(INSTALLROOT)$(XYMONHOME)/web || true
	ln -s $(INSTALLWEBDIR) $(INSTALLROOT)$(XYMONHOME)/web || true
endif
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(INSTALLWEBDIR)
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(INSTALLWEBDIR)
	test -L $(INSTALLROOT)$(INSTALLWEBDIR) || chmod 755 $(INSTALLROOT)$(INSTALLWEBDIR)
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(INSTALLWWWDIR) $(INSTALLROOT)$(INSTALLSTATICWWWDIR)/gifs $(INSTALLROOT)$(INSTALLSTATICWWWDIR)/help $(INSTALLROOT)$(INSTALLWWWDIR)/html $(INSTALLROOT)$(INSTALLSTATICWWWDIR)/menu $(INSTALLROOT)$(INSTALLWWWDIR)/notes $(INSTALLROOT)$(INSTALLWWWDIR)/rep $(INSTALLROOT)$(INSTALLWWWDIR)/snap)
ifneq ($(INSTALLSTATICWWWDIR),$(INSTALLWWWDIR))
	@for d in gifs help menu; do \
		if test -d $(INSTALLROOT)$(INSTALLWWWDIR)/$$d && test ! -L $(INSTALLROOT)$(INSTALLWWWDIR)/$$d; then \
			echo "*** $(INSTALLWWWDIR)/$$d is a real directory; leaving it alone."; \
			echo "*** Move its contents to $(INSTALLSTATICWWWDIR)/$$d and remove it."; \
		else \
			rm -f $(INSTALLROOT)$(INSTALLWWWDIR)/$$d; \
			ln -s $(INSTALLSTATICWWWDIR)/$$d $(INSTALLROOT)$(INSTALLWWWDIR)/$$d; \
		fi; \
	done
endif
ifneq ($(INSTALLWWWDIR),$(XYMONHOME)/www)
	rm -f $(INSTALLROOT)$(XYMONHOME)/www || true
	ln -s $(INSTALLWWWDIR) $(INSTALLROOT)$(XYMONHOME)/www || true
endif
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(INSTALLWWWDIR) $(INSTALLROOT)$(INSTALLSTATICWWWDIR)/gifs $(INSTALLROOT)$(INSTALLSTATICWWWDIR)/help $(INSTALLROOT)$(INSTALLWWWDIR)/html $(INSTALLROOT)$(INSTALLSTATICWWWDIR)/menu $(INSTALLROOT)$(INSTALLWWWDIR)/notes $(INSTALLROOT)$(INSTALLWWWDIR)/rep $(INSTALLROOT)$(INSTALLWWWDIR)/snap
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)`  $(INSTALLROOT)$(INSTALLWWWDIR) $(INSTALLROOT)$(INSTALLSTATICWWWDIR)/gifs $(INSTALLROOT)$(INSTALLSTATICWWWDIR)/help $(INSTALLROOT)$(INSTALLWWWDIR)/html $(INSTALLROOT)$(INSTALLSTATICWWWDIR)/menu $(INSTALLROOT)$(INSTALLWWWDIR)/notes $(INSTALLROOT)$(INSTALLWWWDIR)/rep $(INSTALLROOT)$(INSTALLWWWDIR)/snap
	for d in $(INSTALLROOT)$(INSTALLWWWDIR) $(INSTALLROOT)$(INSTALLSTATICWWWDIR)/gifs $(INSTALLROOT)$(INSTALLSTATICWWWDIR)/help $(INSTALLROOT)$(INSTALLWWWDIR)/html $(INSTALLROOT)$(INSTALLSTATICWWWDIR)/menu $(INSTALLROOT)$(INSTALLWWWDIR)/notes $(INSTALLROOT)$(INSTALLWWWDIR)/rep $(INSTALLROOT)$(INSTALLWWWDIR)/snap; do test -L $$d || chmod 755 $$d; done
ifdef HTTPDGID
# The www/rep and www/snap directories must be writable by the apache daemon
	chgrp -h $(HTTPDGID) $(INSTALLROOT)$(INSTALLWWWDIR)/rep $(INSTALLROOT)$(INSTALLWWWDIR)/snap
endif
	for d in $(INSTALLROOT)$(INSTALLWWWDIR)/rep $(INSTALLROOT)$(INSTALLWWWDIR)/snap; do test -L $$d || chmod g+w $$d; done
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(XYMONVAR)/acks)
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(XYMONVAR)/acks
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(XYMONVAR)/acks
	# These $(XYMONVAR) subdirectories belong to $(XYMONUSER), who may relocate
	# one to another disk with a symlink -- mkdir -p then no-ops and chown -h
	# acts on the link, both on purpose. chmod has no portable -h, so skip it
	# when the name is a symlink rather than follow it to the target's mode.
	test -L $(INSTALLROOT)$(XYMONVAR)/acks || chmod 755 $(INSTALLROOT)$(XYMONVAR)/acks
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(XYMONVAR)/data)
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(XYMONVAR)/data
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(XYMONVAR)/data
	test -L $(INSTALLROOT)$(XYMONVAR)/data || chmod 755 $(INSTALLROOT)$(XYMONVAR)/data
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(XYMONVAR)/disabled)
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(XYMONVAR)/disabled
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(XYMONVAR)/disabled
	test -L $(INSTALLROOT)$(XYMONVAR)/disabled || chmod 755 $(INSTALLROOT)$(XYMONVAR)/disabled
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(XYMONVAR)/hist)
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(XYMONVAR)/hist
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(XYMONVAR)/hist
	test -L $(INSTALLROOT)$(XYMONVAR)/hist || chmod 755 $(INSTALLROOT)$(XYMONVAR)/hist
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(XYMONVAR)/histlogs)
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(XYMONVAR)/histlogs || echo "Warning: Could not set owner on the histlogs directory"
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(XYMONVAR)/histlogs || echo "Warning: Could not set group on the histlogs directory"
	test -L $(INSTALLROOT)$(XYMONVAR)/histlogs || chmod 755 $(INSTALLROOT)$(XYMONVAR)/histlogs
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(XYMONVAR)/hostdata)
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(XYMONVAR)/hostdata || echo "Warning: Could not set owner on the hostdata directory"
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(XYMONVAR)/hostdata || echo "Warning: Could not set group on the hostdata directory"
	test -L $(INSTALLROOT)$(XYMONVAR)/hostdata || chmod 755 $(INSTALLROOT)$(XYMONVAR)/hostdata
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(XYMONVAR)/logs)
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(XYMONVAR)/logs
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(XYMONVAR)/logs
	test -L $(INSTALLROOT)$(XYMONVAR)/logs || chmod 755 $(INSTALLROOT)$(XYMONVAR)/logs
endif

	(umask 022 && mkdir -p $(INSTALLROOT)$(XYMONVAR)/rrd)
ifndef PKGBUILD
	chown -h $(XYMONUSER) $(INSTALLROOT)$(XYMONVAR)/rrd
	chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$(XYMONVAR)/rrd
	test -L $(INSTALLROOT)$(XYMONVAR)/rrd || chmod 755 $(INSTALLROOT)$(XYMONVAR)/rrd
endif

# The install-bin targets of common, xymongen and xymonnet depend on their
# programs, so an install that finds one older than the libraries rebuilds it
# in the install sub-make -- which then needs what the build gave it, or it
# links without SSLLIBS and the rest (#865). A prefix on those calls, not an
# export: an exported variable reaches every recipe, make test's suite with it
# (tests/lib/assert.sh).
SUBMAKE_BUILD_ENV = CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" SSLFLAGS="$(SSLFLAGS)" SSLINCDIR="$(SSLINCDIR)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)" LIBRTDEF="$(LIBRTDEF)" ZLIBINCDIR="$(ZLIBINCDIR)" ZLIBLIBS="$(ZLIBLIBS)" PCREINCDIR="$(PCREINCDIR)" PCRELIBS="$(PCRELIBS)" CARESINCDIR="$(CARESINCDIR)" CARESLIBS="$(CARESLIBS)" DOLDAP="$(DOLDAP)" LDAPFLAGS="$(LDAPFLAGS)" LDAPINCDIR="$(LDAPINCDIR)" LDAPLIBS="$(LDAPLIBS)" SQLITELIBS="$(SQLITELIBS)" RUNTIMEDEFS="$(RUNTIMEDEFS)" HISTGRAPHDEF="$(HISTGRAPHDEF)" SNMPINCDIR="$(SNMPINCDIR)" SNMPLIBS="$(SNMPLIBS)"

install-common: install-dirs
	$(SUBMAKE_BUILD_ENV) XYMONHOME="$(XYMONHOME)" MANROOT="$(MANROOT)" XYMONUSER="$(XYMONUSER)" IDTOOL="$(IDTOOL)" PKGBUILD="$(PKGBUILD)" INSTALLROOT="$(INSTALLROOT)" INSTALLBINDIR="$(INSTALLBINDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" INSTALLEXTDIR="$(INSTALLEXTDIR)" INSTALLTMPDIR="$(INSTALLTMPDIR)" INSTALLWEBDIR="$(INSTALLWEBDIR)" INSTALLWWWDIR="$(INSTALLWWWDIR)" $(MAKE) -C common install

# Opt-in, not in INSTALLTARGETS: on main these are static archives and
# headers that nothing reads at runtime. (devel keeps it in the default
# list, rightly -- there the binaries link the shared objects it
# installs.) Out of the default it also cannot land inside $(XYMONHOME)
# unasked, where a spec globbing the server tree would swallow it into
# the main package and collide with its own -devel one.
#
# It makes its own directories rather than install-dirs doing it: a
# target nobody invoked should leave nothing behind, not even empty ones.
#
# Named for what it installs, as the other targets are -- devel calls
# this install-libs, which describes the archives but not the headers.
#
# Server builds only: a client build makes neither libxymon nor
# libxymoncomm, so the kit would install three client archives under a
# xymon.pc naming libraries that are not there.
ifeq ($(CLIENTONLY),yes)
install-devel:
	@echo "install-devel: a client-only build does not build libxymon; build the server to get the development kit" >&2
	@exit 1
else
# After lib-build, so the archives are complete and current before they are
# copied, even when make runs it in the same parallel run as the build.
install-devel: lib-build
	mkdir -p $(INSTALLROOT)$(INSTALLLIBDIR) $(INSTALLROOT)$(INSTALLINCDIR)
# A back-compat symlink so $(XYMONHOME)/sdk keeps resolving when the kit is
# relocated as a tree, by INSTALLSDKDIR. A split across FHS trees has no
# single directory to point at -- the headers and archives are apart -- so
# it gets none. A package build owns its layout through its own file list
# and does not want it -- an unpackaged symlink is a hard error to rpmbuild
# and dpkg -- so skip it under PKGBUILD. A real $(XYMONHOME)/sdk left by an
# earlier default install is not a symlink, so rm -f cannot clear it and ln
# would drop the link inside it, where the old kit keeps resolving unseen:
# link only when nothing solid is there, and say so otherwise.
ifndef PKGBUILD
ifneq ($(INSTALLSDKDIR),$(XYMONHOME)/sdk)
	mkdir -p $(INSTALLROOT)$(XYMONHOME)
	if [ -d $(INSTALLROOT)$(XYMONHOME)/sdk ] && [ ! -L $(INSTALLROOT)$(XYMONHOME)/sdk ]; then \
		echo "install-devel: $(XYMONHOME)/sdk is a directory from an earlier install; not linking it to $(INSTALLSDKDIR)" >&2; \
	else \
		ln -sfn $(INSTALLSDKDIR) $(INSTALLROOT)$(XYMONHOME)/sdk; \
	fi
endif
endif
	XYMONHOME="$(XYMONHOME)" INSTALLROOT="$(INSTALLROOT)" INSTALLLIBDIR="$(INSTALLLIBDIR)" INSTALLINCDIR="$(INSTALLINCDIR)" $(MAKE) -C lib install
	# A pkg-config file so a consumer builds against the installed tree with
	# "pkg-config --cflags --libs --static xymon" and needs to know neither
	# the sibling header layout nor the static-link chain. Generated with the
	# configured paths and library flags, so it tracks a relocated install.
	mkdir -p $(INSTALLROOT)$(INSTALLPCDIR)
	XYMONHOME='$(XYMONHOME)' INSTALLINCDIR='$(INSTALLINCDIR)' INSTALLLIBDIR='$(INSTALLLIBDIR)' XYMONVERSION='$(XYMONVERSION)' PCREINCDIR='$(PCREINCDIR)' PCRELIBS='$(PCRELIBS)' SSLLIBS='$(SSLLIBS)' LIBRTDEF='$(LIBRTDEF)' $(BUILDTOPDIR)/build/subst.sh XYMONHOME INSTALLINCDIR INSTALLLIBDIR XYMONVERSION PCREINCDIR PCRELIBS SSLLIBS LIBRTDEF <$(BUILDTOPDIR)/build/xymon.pc.in >$(INSTALLROOT)$(INSTALLPCDIR)/xymon.pc
	chmod 644 $(INSTALLROOT)$(INSTALLPCDIR)/xymon.pc
endif

install-xymongen: install-common
	$(SUBMAKE_BUILD_ENV) XYMONHOME="$(XYMONHOME)" MANROOT="$(MANROOT)" XYMONUSER="$(XYMONUSER)" IDTOOL="$(IDTOOL)" PKGBUILD="$(PKGBUILD)" CGIDIR="$(CGIDIR)" SECURECGIDIR="$(SECURECGIDIR)" INSTALLROOT="$(INSTALLROOT)" INSTALLBINDIR="$(INSTALLBINDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" INSTALLEXTDIR="$(INSTALLEXTDIR)" INSTALLTMPDIR="$(INSTALLTMPDIR)" INSTALLWEBDIR="$(INSTALLWEBDIR)" INSTALLWWWDIR="$(INSTALLWWWDIR)" $(MAKE) -C xymongen install

install-xymonnet: install-common
	$(SUBMAKE_BUILD_ENV) XYMONHOME="$(XYMONHOME)" MANROOT="$(MANROOT)" XYMONUSER="$(XYMONUSER)" IDTOOL="$(IDTOOL)" FPINGVER="$(FPINGVER)" DOSNMP="$(DOSNMP)" INSTALLROOT="$(INSTALLROOT)" INSTALLBINDIR="$(INSTALLBINDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" INSTALLEXTDIR="$(INSTALLEXTDIR)" INSTALLTMPDIR="$(INSTALLTMPDIR)" INSTALLWEBDIR="$(INSTALLWEBDIR)" INSTALLWWWDIR="$(INSTALLWWWDIR)" PKGBUILD="$(PKGBUILD)" $(MAKE) -C xymonnet install

install-xymonproxy: install-common
	XYMONHOME="$(XYMONHOME)" MANROOT="$(MANROOT)" XYMONUSER="$(XYMONUSER)" IDTOOL="$(IDTOOL)" PKGBUILD="$(PKGBUILD)" INSTALLROOT="$(INSTALLROOT)" INSTALLBINDIR="$(INSTALLBINDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" INSTALLEXTDIR="$(INSTALLEXTDIR)" INSTALLTMPDIR="$(INSTALLTMPDIR)" INSTALLWEBDIR="$(INSTALLWEBDIR)" INSTALLWWWDIR="$(INSTALLWWWDIR)" $(MAKE) -C xymonproxy install

install-xymond: install-common
	DORRD="$(DORRD)" MANROOT="$(MANROOT)" XYMONTOPDIR="$(XYMONTOPDIR)" XYMONHOME="$(XYMONHOME)" XYMONVAR="$(XYMONVAR)" CGIDIR="$(CGIDIR)" SECURECGIDIR="$(SECURECGIDIR)" XYMONLOGDIR="$(XYMONLOGDIR)" XYMONUSER="$(XYMONUSER)" IDTOOL="$(IDTOOL)" PKGBUILD="$(PKGBUILD)" INSTALLROOT="$(INSTALLROOT)" INSTALLBINDIR="$(INSTALLBINDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" INSTALLEXTDIR="$(INSTALLEXTDIR)" INSTALLTMPDIR="$(INSTALLTMPDIR)" INSTALLWEBDIR="$(INSTALLWEBDIR)" INSTALLWWWDIR="$(INSTALLWWWDIR)" HTTPDGID="$(HTTPDGID)" $(MAKE) -C xymond install

install-web: install-common
	DORRD="$(DORRD)" MANROOT="$(MANROOT)" XYMONTOPDIR="$(XYMONTOPDIR)" XYMONHOME="$(XYMONHOME)" XYMONVAR="$(XYMONVAR)" CGIDIR="$(CGIDIR)" SECURECGIDIR="$(SECURECGIDIR)" XYMONLOGDIR="$(XYMONLOGDIR)" XYMONUSER="$(XYMONUSER)" IDTOOL="$(IDTOOL)" PKGBUILD="$(PKGBUILD)" INSTALLROOT="$(INSTALLROOT)" INSTALLBINDIR="$(INSTALLBINDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" INSTALLEXTDIR="$(INSTALLEXTDIR)" INSTALLTMPDIR="$(INSTALLTMPDIR)" INSTALLWEBDIR="$(INSTALLWEBDIR)" INSTALLWWWDIR="$(INSTALLWWWDIR)" $(MAKE) -C web install
	find $(INSTALLROOT)$(INSTALLWWWDIR) -type f -exec chmod 644 {} \;


# NOTE: This one is normally not used - man-page install is done by the sub-Makefiles during "make install"
install-man:
	XYMONHOME="$(XYMONHOME)" MANROOT="$(MANROOT)" INSTALLROOT="$(INSTALLROOT)" $(MAKE) -C common install-man
	XYMONHOME="$(XYMONHOME)" MANROOT="$(MANROOT)" CGIDIR="$(CGIDIR)" SECURECGIDIR="$(SECURECGIDIR)" INSTALLROOT="$(INSTALLROOT)" $(MAKE) -C xymongen install-man
	XYMONHOME="$(XYMONHOME)" MANROOT="$(MANROOT)" INSTALLROOT="$(INSTALLROOT)" $(MAKE) -C xymonnet install-man
	XYMONHOME="$(XYMONHOME)" MANROOT="$(MANROOT)" INSTALLROOT="$(INSTALLROOT)" $(MAKE) -C xymonproxy install-man
	XYMONHOME="$(XYMONHOME)" MANROOT="$(MANROOT)" INSTALLROOT="$(INSTALLROOT)" $(MAKE) -C xymond install-man
	XYMONHOME="$(XYMONHOME)" MANROOT="$(MANROOT)" INSTALLROOT="$(INSTALLROOT)" $(MAKE) -C web install-man
	find $(INSTALLROOT)$(MANROOT) -type f -exec chmod 644 {} \;

# install-dirs makes the www tree and, when INSTALLSTATICWWWDIR is set, the
# www/help -> static/help symlink the runtime help path resolves through. The
# other runtime install targets reach it via install-common; install-docs was
# the one that did not, so a standalone "make install-docs" left help unlinked.
install-docs: install-dirs
	XYMONHOME="$(XYMONHOME)" MANROOT="$(MANROOT)" XYMONUSER="$(XYMONUSER)" IDTOOL="$(IDTOOL)" PKGBUILD="$(PKGBUILD)" INSTALLROOT="$(INSTALLROOT)" INSTALLBINDIR="$(INSTALLBINDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" INSTALLEXTDIR="$(INSTALLEXTDIR)" INSTALLTMPDIR="$(INSTALLTMPDIR)" INSTALLWEBDIR="$(INSTALLWEBDIR)" INSTALLWWWDIR="$(INSTALLWWWDIR)" $(MAKE) -C docs install

# Opt-in: "make install-tools" after a build installs the diagnostic
# programs the build produces but discards -- lib/'s four and
# xymonnet's xymonnetprobe. Not in INSTALLTARGETS, so an ordinary install is
# unchanged. Server builds only: a client build compiles none of them,
# and would otherwise build lib/'s on demand, install them, and then fail
# linking xymonnetprobe without c-ares -- half an install.
ifeq ($(CLIENTONLY),yes)
install-tools:
	@echo "install-tools: a client-only build does not build these diagnostics; build the server to get them" >&2
	@exit 1
else
install-tools:
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" OSDEF="$(OSDEF)" RPATHOPT="$(RPATHOPT)" PCREINCDIR="$(PCREINCDIR)" ZLIBINCDIR="$(ZLIBINCDIR)" SSLFLAGS="$(SSLFLAGS)" SSLINCDIR="$(SSLINCDIR)" SSLLIBS="$(SSLLIBS)" NETLIBS="$(NETLIBS)" LIBRTDEF="$(LIBRTDEF)" XYMONTOPDIR="$(XYMONTOPDIR)" XYMONHOME="$(XYMONHOME)" XYMONCLIENTHOME="$(XYMONCLIENTHOME)" XYMONLOGDIR="$(XYMONLOGDIR)" XYMONHOSTNAME="$(XYMONHOSTNAME)" XYMONHOSTIP="$(XYMONHOSTIP)" XYMONHOSTOS="$(XYMONHOSTOS)" MANROOT="$(MANROOT)" XYMONUSER="$(XYMONUSER)" IDTOOL="$(IDTOOL)" PKGBUILD="$(PKGBUILD)" INSTALLROOT="$(INSTALLROOT)" INSTALLBINDIR="$(INSTALLBINDIR)" $(MAKE) -C lib install-tools
	CC="$(CC)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" CPPFLAGS="$(CPPFLAGS)" RPATHOPT="$(RPATHOPT)" SSLFLAGS="$(SSLFLAGS)" SSLINCDIR="$(SSLINCDIR)" SSLLIBS="$(SSLLIBS)" DOLDAP="$(DOLDAP)" LDAPFLAGS="$(LDAPFLAGS)" LDAPINCDIR="$(LDAPINCDIR)" LDAPLIBS="$(LDAPLIBS)" DOSNMP="$(DOSNMP)" NETLIBS="$(NETLIBS)" XYMONHOME="$(XYMONHOME)" ARESVER="$(ARESVER)" FPINGVER="$(FPINGVER)" RUNTIMEDEFS="$(RUNTIMEDEFS)" PCREINCDIR="$(PCREINCDIR)" PCRELIBS="$(PCRELIBS)" SYSTEMCARES="$(SYSTEMCARES)" CARESINCDIR="$(CARESINCDIR)" CARESLIBS="$(CARESLIBS)" SQLITELIBS="$(SQLITELIBS)" ZLIBINCDIR="$(ZLIBINCDIR)" ZLIBLIBS="$(ZLIBLIBS)" LIBRTDEF="$(LIBRTDEF)" XYMONUSER="$(XYMONUSER)" IDTOOL="$(IDTOOL)" PKGBUILD="$(PKGBUILD)" INSTALLROOT="$(INSTALLROOT)" INSTALLBINDIR="$(INSTALLBINDIR)" $(MAKE) -C xymonnet install-tools
endif

install-custom:
	XYMONHOME="$(XYMONHOME)" MANROOT="$(MANROOT)" XYMONUSER="$(XYMONUSER)" IDTOOL="$(IDTOOL)" PKGBUILD="$(PKGBUILD)" INSTALLROOT="$(INSTALLROOT)" INSTALLBINDIR="$(INSTALLBINDIR)" INSTALLETCDIR="$(INSTALLETCDIR)" INSTALLEXTDIR="$(INSTALLEXTDIR)" INSTALLTMPDIR="$(INSTALLTMPDIR)" INSTALLWEBDIR="$(INSTALLWEBDIR)" INSTALLWWWDIR="$(INSTALLWWWDIR)" $(MAKE) -C custom install || echo "Skipped custom modules"


client-install: install-client

# Same shape as install-dirs does for the server: make the directory,
# and when it is not the default leave a symlink where the default was,
# so $XYMONCLIENTHOME/etc keeps resolving -- clientlaunch.cfg and the
# server's tasks.cfg both spell it that way.
#
# A real directory where a link should go is an earlier install's: the
# client still runs from it, so installing beside it would leave the client
# on its old files. Stop instead, before anything is installed.
#
# Only a directory this rule creates is given to XYMONUSER: a relocated one
# that already exists may be shared with the rest of the system. Its parents
# are made 755 whatever the umask, or the xymon user could not reach it.
#
# A directory is the default when it is $(CLIENTHOME)/etc by name, or when
# it and the default both exist and are the same directory. Comparing names
# alone is not enough: /xc//etc, /xc/./etc and a path through a symlinked
# parent all name /xc/etc, and taken for a relocation they would stop a
# reinstall on "is a real directory", or have a first install replace the
# directory it has just made with a link to itself. Both are resolved under
# INSTALLROOT with "cd && pwd -P", which build/build-id.sh already needs of
# the shell in every build, unlike realpath, readlink -f or test -ef; an
# empty answer is never taken for a match. cd's own output is discarded: with
# CDPATH set and a relative INSTALLROOT, cd prints the directory it chose,
# and that line would be compared too. The second loop compares after it
# creates the directory, so a first install finds the two the same too.
CLIENTDIRS = etc:$(INSTALLCLIENTETCDIR) bin:$(INSTALLCLIENTBINDIR) tmp:$(INSTALLCLIENTTMPDIR) logs:$(INSTALLCLIENTLOGDIR)
CLIENTDIR_DEFAULT = { test "$$to" = "$(CLIENTHOME)/$$d" || { test -d $(INSTALLROOT)$$to && test -d $$old && here=`cd $(INSTALLROOT)$$to >/dev/null && pwd -P` && test -n "$$here" && test "$$here" = "`cd $$old >/dev/null && pwd -P`"; }; }
ifndef PKGBUILD
CLIENTDIR_OWN = chown -h $(XYMONUSER) $(INSTALLROOT)$$to && chgrp -h `$(IDTOOL) -g $(XYMONUSER)` $(INSTALLROOT)$$to || exit 1;
endif

install-clientdirs:
	@for p in $(CLIENTDIRS); do \
		d=$${p%%:*}; to=$${p#*:}; to=$${to%/}; old=$(INSTALLROOT)$(CLIENTHOME)/$$d; \
		$(CLIENTDIR_DEFAULT) && continue; \
		if test -d $$old && test ! -L $$old; then \
			echo "*** $(CLIENTHOME)/$$d is a real directory, but the client's $$d is now installed in $$to." >&2; \
			echo "*** Move its contents to $$to and remove it, then install again." >&2; \
			exit 1; \
		fi; \
	done
	test -d $(INSTALLROOT)$(CLIENTHOME) || { (umask 022 && mkdir -p $(INSTALLROOT)$(CLIENTHOME)) && chmod 755 $(INSTALLROOT)$(CLIENTHOME); }
	@for p in $(CLIENTDIRS); do \
		d=$${p%%:*}; to=$${p#*:}; to=$${to%/}; old=$(INSTALLROOT)$(CLIENTHOME)/$$d; \
		if test ! -d $(INSTALLROOT)$$to; then \
			(umask 022 && mkdir -p $(INSTALLROOT)$$to) && { test -L $(INSTALLROOT)$$to || chmod 755 $(INSTALLROOT)$$to; } || exit 1; \
			$(CLIENTDIR_OWN) \
		fi; \
		$(CLIENTDIR_DEFAULT) && continue; \
		rm -f $$old && ln -s $$to $$old || exit 1; \
	done

install-client: client install-clientdirs
	XYMONHOME="$(XYMONCLIENTHOME)" INSTALLROOT="$(INSTALLROOT)" XYMONUSER="$(XYMONUSER)" IDTOOL="$(IDTOOL)" PKGBUILD="$(PKGBUILD)" LOCALCLIENT="$(LOCALCLIENT)" $(MAKE) -C client install INSTALLCLIENTETCDIR="$(INSTALLCLIENTETCDIR)" INSTALLCLIENTBINDIR="$(INSTALLCLIENTBINDIR)" INSTALLCLIENTTMPDIR="$(INSTALLCLIENTTMPDIR)" INSTALLCLIENTLOGDIR="$(INSTALLCLIENTLOGDIR)"

install-clientmsg:
	@echo ""
	@echo "Installation complete."
	@echo ""
	@echo "To start the Xymon client, as the $(XYMONUSER) user run '${XYMONHOME}/runclient.sh start'"

install-localclient: install-clientdirs
	XYMONHOME="$(XYMONCLIENTHOME)" INSTALLROOT="$(INSTALLROOT)" XYMONUSER="$(XYMONUSER)" IDTOOL="$(IDTOOL)" LOCALCLIENT="$(LOCALCLIENT)" $(MAKE) -C client install-localclient INSTALLCLIENTETCDIR="$(INSTALLCLIENTETCDIR)" INSTALLCLIENTBINDIR="$(INSTALLCLIENTBINDIR)" INSTALLCLIENTTMPDIR="$(INSTALLCLIENTTMPDIR)" INSTALLCLIENTLOGDIR="$(INSTALLCLIENTLOGDIR)"
