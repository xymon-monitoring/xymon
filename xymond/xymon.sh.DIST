#!/bin/sh

# Startup script for Xymon
#
# This starts the "xymonlaunch" tool, which in turn starts
# all of the other Xymon server programs.

case "`uname -s`" in
   "SunOS")
   	ID=/usr/xpg4/bin/id
	;;
   *)
   	ID=id
	;;
esac

if test `$ID -un` != @XYMONUSER@
then
	echo "Xymon must be started as the @XYMONUSER@ user"
	exit 1
fi

case "$1" in
   "start")
	# The runtime directory may be volatile - that is the point of pointing it
	# at /run - so it can be gone after a reboot. Without it every pidfile
	# write fails silently and start reports success while stop, status and
	# reload have nothing to read.
	if test ! -d @XYMONRUNDIR@
	then
		mkdir -p @XYMONRUNDIR@ || { echo "Cannot create @XYMONRUNDIR@"; exit 1; }
	fi

	if test -s @XYMONRUNDIR@/xymonlaunch.pid
	then
		kill -0 `cat @XYMONRUNDIR@/xymonlaunch.pid`
		if test $? -eq 0
		then
			echo "Xymon appears to be running, doing restart"
			$0 stop
		else
			rm -f @XYMONRUNDIR@/xymonlaunch.pid
		fi
	fi

	@RUNTIMEDEFS@ @XYMONHOME@/bin/xymonlaunch --config=@XYMONHOME@/etc/tasks.cfg --env=@XYMONHOME@/etc/xymonserver.cfg --log=@XYMONLOGDIR@/xymonlaunch.log --pidfile=@XYMONRUNDIR@/xymonlaunch.pid
	echo "Xymon started"
	;;

   "stop")
	if test -s @XYMONRUNDIR@/xymonlaunch.pid
	then
		kill -TERM `cat @XYMONRUNDIR@/xymonlaunch.pid`
		echo "Xymon stopped"
	else
		echo "Xymon is not running"
	fi
	rm -f @XYMONRUNDIR@/xymonlaunch.pid
	;;

   "status")
	if test -s @XYMONRUNDIR@/xymonlaunch.pid
	then
		kill -0 `cat @XYMONRUNDIR@/xymonlaunch.pid`
		if test $? -eq 0
		then
			echo "Xymon (xymonlaunch) running with PID `cat @XYMONRUNDIR@/xymonlaunch.pid`"
			exit 0
		else
			echo "Xymon not running, removing stale PID file"
			rm -f @XYMONRUNDIR@/xymonlaunch.pid
			exit 1
		fi
	else
		echo "Xymon (xymonlaunch) does not appear to be running"
		exit 3
	fi
	;;

   "restart")
	if test -s @XYMONRUNDIR@/xymonlaunch.pid
	then
		$0 stop
		sleep 10
		$0 start
	else
		echo "xymonlaunch does not appear to be running, starting it"
		$0 start
	fi
	;;

   "reload")
	if test -s @XYMONRUNDIR@/xymond.pid
	then
		kill -HUP `cat @XYMONRUNDIR@/xymond.pid`
	else
		echo "xymond not running (no PID file)"
	fi
	;;

   "rotate")
   	for PIDFILE in @XYMONRUNDIR@/*.pid
	do
		kill -HUP `cat $PIDFILE`
	done
	;;

   *)
	echo "Usage: $0 start|stop|restart|reload|status|rotate" >&2
	exit 2
esac

exit 0

