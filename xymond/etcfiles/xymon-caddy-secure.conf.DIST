# Xymon configuration for Caddy, with the administration CGIs password-protected.
#
# Generated by the Xymon build with this install's paths. This is a set of
# directives to place inside a Caddy site block, not a standalone Caddyfile.
#
# Caddy has no CGI of its own. Xymon's CGIs (the files in the CGI directory are
# cgiwrap binaries) run through fcgiwrap over FastCGI -- stock Caddy, no plugin
# needed. Install fcgiwrap and point the reverse_proxy socket below at it, e.g.
# on Debian/Ubuntu:
#     apt-get install fcgiwrap
#     systemctl enable --now fcgiwrap.socket

# Static web pages: @XYMONHOSTURL@/ -> @INSTALLWWWDIR@/
@xymonbare path @XYMONHOSTURL@
redir @xymonbare @XYMONHOSTURL@/ 301
handle_path @XYMONHOSTURL@/* {
	root * @INSTALLWWWDIR@
	file_server
}

# CGI scripts, executed by fcgiwrap
handle_path @XYMONCGIURL@/* {
	reverse_proxy unix//run/fcgiwrap.socket {
		transport fastcgi {
			env SCRIPT_FILENAME @CGIDIR@{http.request.uri.path}
			env SCRIPT_NAME     @XYMONCGIURL@{http.request.uri.path}
		}
	}
}

# Administration CGIs, password-protected.
#
# Caddy's basic_auth does not read an htpasswd file -- credentials are inline
# bcrypt hashes. The hash below is a locked placeholder (a random password no
# one knows), so access stays denied until you REPLACE it with your own:
#     caddy hash-password
# Add more "username hash" lines for more users.
handle_path @SECUREXYMONCGIURL@/* {
	basic_auth {
		admin $2a$14$29rOAYliOJ4dYeTmMeDr5e3y2ylAd0H5YyF7s1gMR4/EeKTyvTI5.
	}
	reverse_proxy unix//run/fcgiwrap.socket {
		transport fastcgi {
			env SCRIPT_FILENAME @SECURECGIDIR@{http.request.uri.path}
			env SCRIPT_NAME     @SECUREXYMONCGIURL@{http.request.uri.path}
		}
	}
}
