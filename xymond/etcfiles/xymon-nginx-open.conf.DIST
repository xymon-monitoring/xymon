# Xymon configuration for nginx (open -- no CGI authentication).
#
# Generated by the Xymon build with this install's paths. Unlike Apache and
# lighttpd, nginx has no include-anywhere config file, so this is a set of
# location blocks to include inside an nginx "server { }" block, not a
# standalone config.
#
# nginx cannot run CGI programs itself. Xymon's CGIs (the files in the CGI
# directory are cgiwrap binaries) are executed through fcgiwrap, which you
# install and run separately, e.g. on Debian/Ubuntu:
#     apt-get install fcgiwrap
#     systemctl enable --now fcgiwrap.socket
# Point the fastcgi_pass socket below at the one fcgiwrap listens on.

# Static web pages: @XYMONHOSTURL@/ -> @INSTALLWWWDIR@/
location = @XYMONHOSTURL@ { return 301 @XYMONHOSTURL@/; }
location @XYMONHOSTURL@/ {
    alias     @INSTALLWWWDIR@/;
    autoindex off;
}

# CGI scripts, executed by fcgiwrap
location ~ ^@XYMONCGIURL@/(?<xymoncgi>.+)$ {
    fastcgi_pass  unix:/run/fcgiwrap.socket;
    include       fastcgi_params;
    fastcgi_param SCRIPT_FILENAME @CGIDIR@/$xymoncgi;
    fastcgi_param SCRIPT_NAME     @XYMONCGIURL@/$xymoncgi;
}
