# Xymon configuration for nginx, with the administration CGIs password-protected.
#
# Generated by the Xymon build with this install's paths. Unlike Apache and
# lighttpd, nginx has no include-anywhere config file, so this is a set of
# location blocks to include inside an nginx "server { }" block, not a
# standalone config.
#
# nginx cannot run CGI programs itself. Xymon's CGIs (the files in the CGI
# directory are cgiwrap binaries) are executed through fcgiwrap, which you
# install and run separately, e.g. on Debian/Ubuntu:
#     apt-get install fcgiwrap
#     systemctl enable --now fcgiwrap.socket
# Point the fastcgi_pass socket below at the one fcgiwrap listens on.

# Static web pages: @XYMONHOSTURL@/ -> @INSTALLWWWDIR@/
@NGINXBAREREDIRECT@
location @XYMONHOSTURL@/ {
    alias     @INSTALLWWWDIR@/;
    autoindex off;
}

# Administration CGIs, password-protected
# The password guards the URL @SECUREXYMONCGIURL@/, not the directory
# @SECURECGIDIR@ (Apache's config guards the directory). That holds only
# while @SECURECGIDIR@ differs from @CGIDIR@: if they were one directory,
# the administration CGIs would also run through @XYMONCGIURL@/ without a
# password.
# This block comes before the one for @XYMONCGIURL@/: nginx uses the first
# regex location that matches, so a secure URL under the open one stays
# behind the password.
location ~ ^@SECUREXYMONCGIURL@/(?<xymonseccgi>.+)$ {
    auth_basic           "Xymon Administration";
    # Password file, created with:
    #   htpasswd -c @INSTALLETCDIR@/xymonpasswd USERNAME
    auth_basic_user_file @INSTALLETCDIR@/xymonpasswd;

    fastcgi_pass  unix:/run/fcgiwrap.socket;
    include       fastcgi_params;
    fastcgi_param SCRIPT_FILENAME @SECURECGIDIR@/$xymonseccgi;
    fastcgi_param SCRIPT_NAME     @SECUREXYMONCGIURL@/$xymonseccgi;
}

# CGI scripts, executed by fcgiwrap
location ~ ^@XYMONCGIURL@/(?<xymoncgi>.+)$ {
    fastcgi_pass  unix:/run/fcgiwrap.socket;
    include       fastcgi_params;
    fastcgi_param SCRIPT_FILENAME @CGIDIR@/$xymoncgi;
    fastcgi_param SCRIPT_NAME     @XYMONCGIURL@/$xymoncgi;
}
