# Xymon configuration for lighttpd, with the administration CGIs password-protected.
#
# Generated by the Xymon build with this install's paths -- the lighttpd
# equivalent of xymon-apache.conf. lighttpd runs Xymon's CGIs natively through
# mod_cgi: the files in the CGI directory are cgiwrap binaries, executed
# directly, so no fcgiwrap or other CGI gateway is needed.
#
# Enable it by including this file from your lighttpd.conf.

server.modules += ( "mod_alias", "mod_auth", "mod_authn_file", "mod_cgi", "mod_redirect" )

# Static web pages: @XYMONHOSTURL@/ -> @INSTALLWWWDIR@/
# The trailing slash on the alias key keeps "@XYMONHOSTURL@/" from also matching
# "@XYMONCGIURL@/..." (which shares the URL as a string prefix). A bare
# "@XYMONHOSTURL@" is redirected to the trailing-slash form.
url.redirect += ( "^@XYMONHOSTURL@$" => "@XYMONHOSTURL@/" )
alias.url    += ( "@XYMONHOSTURL@/" => "@INSTALLWWWDIR@/" )

# CGI scripts: @XYMONCGIURL@/ -> @CGIDIR@/
# Every file under this URL is executed (they are cgiwrap binaries), the same
# as Apache's ScriptAlias. cgi.assign ( "" => "" ) means "run it directly".
alias.url += ( "@XYMONCGIURL@/" => "@CGIDIR@/" )
$HTTP["url"] =~ "^@XYMONCGIURL@/" {
    cgi.assign = ( "" => "" )
}

# Administration CGIs, password-protected: @SECUREXYMONCGIURL@/ -> @SECURECGIDIR@/
alias.url += ( "@SECUREXYMONCGIURL@/" => "@SECURECGIDIR@/" )
$HTTP["url"] =~ "^@SECUREXYMONCGIURL@/" {
    cgi.assign = ( "" => "" )

    # Password file, created with:
    #   htpasswd -c @INSTALLETCDIR@/xymonpasswd USERNAME
    # It should be readable only by the web-server user.
    auth.backend                   = "htpasswd"
    auth.backend.htpasswd.userfile = "@INSTALLETCDIR@/xymonpasswd"
    auth.require = ( "" =>
        (
            "method"  => "basic",
            "realm"   => "Xymon Administration",
            "require" => "valid-user",
        )
    )
}
